# UpGrade backend environment variables
# Copy to .env and fill in real values

APP_NAME="UpGrade API"
ENV="development"

# Neon Postgres connection string
DATABASE_URL="postgresql://neondb_owner:***@ep-delicate-unit-az78801x.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# DATABASE_URL="sqlite:///./upgrade.db"  # fallback for local dev

# Redis connection string (used by: arq job queue, JWT refresh tokens, chat rate limiter)
# use Upstash rediss:// for prod (localhost for dev)
# Local: redis://localhost:6379/0
# Prod: rediss://default:<password>@<host>:6379
REDIS_URL="redis://localhost:6379/0"

# AI Service Keys
GROQ_API_KEY="gsk_..."
OPENCODE_API_KEY="sk-..."

# AI provider selection ("groq" | "opencode") + models / base URLs (OpenAI-compatible)
AI_PROVIDER="groq"
AI_MODEL_GROQ="openai/gpt-oss-120b"
AI_MODEL_OPENCODE="hy3-free"
AI_MODEL_OPENCODE_FALLBACK="nemotron-3-ultra-free"
AI_BASE_URL_GROQ="https://api.groq.com/openai/v1"
AI_BASE_URL_OPENCODE="https://opencode.ai/zen/v1"

# CORS / Frontend origin (prod)
# Set ONE of these in production to lock down CORS (comma-separated for CORS_ORIGINS):
# FRONTEND_URL="https://your-flutter-web.vercel.app"
# CORS_ORIGINS="https://your-flutter-web.vercel.app,https://your-custom-domain.com"
FRONTEND_URL=""
CORS_ORIGINS=""

# Authentication & Secrets
JWT_SECRET="change-me-in-production-jwt-secret"
SECRET_KEY="change-me-in-production-use-env-var"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
